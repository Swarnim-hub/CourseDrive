# App
APP_NAME=CourseDrive
APP_ENV=development
DEBUG=True
API_V1_STR=/api/v1
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# Database
DATABASE_URL=postgresql+asyncpg://coursedrive:coursedrive_password@localhost:5432/coursedrive_db

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT Auth
JWT_SECRET_KEY=coursedrive_super_secret_jwt_key_change_in_production_987654321
JWT_REFRESH_SECRET_KEY=coursedrive_super_secret_refresh_jwt_key_987654321
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Email / SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=no-reply@coursedrive.com
EMAILS_FROM_NAME=CourseDrive Team
USE_TLS=True

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Stripe
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
STRIPE_CURRENCY=usd

# Media storage directory (local fallback)
UPLOAD_DIR=uploads
